{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/xapi/:path*", "destination": "https://api.test.xapi.to/api/:path*" },
    { "source": "/gateway/grid-trading-agent/:path*", "destination": "https://agent-market-grid.p.test.xapi.to/:path*" },
    { "source": "/gateway/liquidity-rebalancing-agent/:path*", "destination": "https://agent-market-liquidity.p.test.xapi.to/:path*" },
    { "source": "/gateway/yield-optimisation-agent/:path*", "destination": "https://agent-market-yield.p.test.xapi.to/:path*" },
    { "source": "/gateway/health-factor-monitoring-agent/:path*", "destination": "https://agent-market-health.p.test.xapi.to/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] },
    { "source": "/xapi/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/gateway/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
